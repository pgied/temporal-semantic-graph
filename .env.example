# Copy this file to .env and adjust it. Relative paths resolve against the project root.

# Dataset files. They are not part of this repository; see README.md, section "Dataset".
TWEETS_PATH=data/raw/sampled_tweets_senate_115-117.jsonl
DECOMPOSITIONS_PATH=data/raw/gpt3.5_tweets_to_gen_all.jsonl

# Embedding model: a Hugging Face Hub name or a local path.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where the pipeline writes embeddings, the graph and figures.
OUTPUT_DIR=outputs
