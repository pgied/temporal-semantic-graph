{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // "python" points to the uv-managed .venv (create it with `uv sync`).
  // macOS and Linux use .venv/bin/python; the "windows" block overrides it with .venv\Scripts\python.exe.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Encode Documents",
      "type": "debugpy",
      "request": "launch",
      "module": "src.encoder",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {},
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    },
    {
      "name": "Map to Graph",
      "type": "debugpy",
      "request": "launch",
      "module": "src.mapper",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {},
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    },
    {
      "name": "Visualize Graph",
      "type": "debugpy",
      "request": "launch",
      "module": "src.visualize",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {},
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    }
  ]
}
